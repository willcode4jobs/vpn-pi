# islandd node configuration.
#
# Install to /etc/islandd/islandd.env  (owner root:islandd, mode 0640 — it may hold the
# admin token, so it must NOT be world-readable). The installer (deploy/install.sh)
# copies this for you. An UNEDITED copy boots a working node: the bind address
# auto-detects from wg0, and a strong admin token auto-generates and is printed.

# Data dir (identity keys + tokens + friends.json + messages.json).
ISLAND_DATA_DIR=/var/lib/islandd

# Bind address + port. ISLAND_HOST is auto-detected from wg0 if omitted; set it only
# to override (or if you use a non-wg0 interface).
# ISLAND_HOST=10.42.0.5
# ISLAND_PORT=8787
# ISLAND_WG_IFACE=wg0

# Display name for this node (defaults to "node").
# ISLAND_LABEL=sirius

# ===================== ADMIN ACCESS (THE ADMIN PASSWORD) =====================
# What you type into the lock at /admin. Leave BLANK to auto-generate one on first
# run (printed in the log, saved to <data>/admin.token). Set your own only if you
# want a known value:  openssl rand -base64 24
ISLAND_ADMIN_TOKEN=
# ============================================================================

# File share. Default is "memory" (not persistent). Most nodes pull vega's share:
# ISLAND_SHARE=remote
# ISLAND_SHARE_URL=http://10.42.0.2:8787
# vega itself keeps the durable share:
# ISLAND_SHARE=sqlite

# ===== registry + IDS collector (POLARIS ONLY) =====
# ISLAND_REGISTRY=1                       # serves the ISL-… friend-code directory
# ISLAND_EVENTS=1                         # collects the mesh-wide security (IDS) feed
# On EVERY OTHER node, point at polaris to announce/friend-by-code AND report events:
# ISLAND_REGISTRY_URL=http://10.42.0.1:8787
# ISLAND_EVENTS_URL=http://10.42.0.1:8787

# ===== gate (VEGA ONLY) — ISLAND_ADMIN_PUBKEY is the canary SIGNER key, NOT the
#       admin password above. See RUNBOOK-gate.md. =====
# ISLAND_ADMIN_PUBKEY=<canary signer ed25519 b64>
# ISLAND_LLAMA_URL=http://127.0.0.1:8080
# ISLAND_GATE_CMD=sudo /usr/local/sbin/island-gate
# ISLAND_GATE_TTL=2700

# ===== admin app (ADMIN'S TRUSTED MACHINE ONLY — e.g. builder) =====
# Holds the admin SIGNING keypair so the app's "Open gate" button mints + opens one-click.
# The key never leaves this machine; POST /api/gate/open is operator-only. Leave ALL of
# these unset on every other node (then that node simply can't open the gate).
# See RUNBOOK-gate-open-from-app.md.
# ISLAND_ADMIN_KEY_DIR=/home/<you>/island-admin       # the `islandd keygen` admin keypair dir
# ISLAND_GATE_TARGET=http://10.42.0.2:8787            # the gate node (vega)
# ISLAND_GATE_TARGET_X25519=<vega x25519 b64>         # seal the canary to vega (vega's x25519.pub)
# ISLAND_GATE_TARGET_TOKEN=<vega admin token>         # to call vega's /admin/canary
# ISLAND_GATE_TARGET_LABEL=vega                       # UI label for the gate (defaults to the
#                                                     # target host); status/log/close proxy to it,
#                                                     # so the app shows the REAL gate, not this box.
