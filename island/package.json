{
  "name": "islandd",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Island-internet node daemon (Phase Two): friending mesh, universal file share, LLM-gated egress. One binary serves the user app and the /admin surface.",
  "scripts": {
    "dev": "bun run src/main.ts --mock",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --outfile islandd src/main.ts"
  },
  "dependencies": {
    "libsodium-wrappers": "^0.7.15"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/libsodium-wrappers": "^0.7.14",
    "typescript": "^5.6.0"
  }
}
