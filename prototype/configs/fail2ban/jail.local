# =============================================================================
# VPN Pi project — fail2ban jail.local (overrides on top of jail.conf)
# =============================================================================
# Sanitized from prototype/configs/fail2ban/current.jail.local. The .current
# file is a 998-line copy of the stock /etc/fail2ban/jail.conf with the [sshd]
# enable block bolted onto the top of the file — the example block in the
# header comment had been partially uncommented, leaving the override lines
# orphaned above any [section] header. This baseline restores correct
# structure: jail.local contains only the overrides, jail.conf provides the
# defaults beneath it.
#
# Applies to every node in the mesh. Deployed by harden-base.sh to
# /etc/fail2ban/jail.local.
#
# Enabled jails:
#   [sshd] — same thresholds as the live VM (maxretry 3, findtime 10m,
#            bantime 1h, systemd backend)
#
# Validate before applying:
#   fail2ban-client -t
# After install:
#   systemctl restart fail2ban && fail2ban-client status sshd
# =============================================================================

[DEFAULT]
# Trust the host's own addresses; never ban ourselves.
ignoreself = true

# Default thresholds (overridden per jail below where stricter values apply).
bantime  = 1h
findtime = 10m
maxretry = 5

# Default ban action: nftables-multiport. Pairs with the deny-by-default
# baseline.nft ruleset. (jail.conf default is iptables-multiport, which is
# wrong on a host using nftables.)
banaction = nftables-multiport
banaction_allports = nftables-allports


[sshd]
enabled  = true
port     = ssh
backend  = systemd
maxretry = 3
findtime = 10m
bantime  = 1h
